{
  "manifest_version": 3,
  "name": "AGENTS.md 对话导入器",
  "version": "3.2.0",
  "description": "管理多条 AGENTS.md 或文本规范，并按配置插入网页聊天输入框。新增配置快捷面板，支持筛选和方向键插入",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite",
    "scripting"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://www.doubao.com/*",
    "https://www.qianwen.com/*",
    "https://chatgpt.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "导入 AGENTS.md",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "inject-agents": {
      "suggested_key": {
        "default": "Ctrl+I"
      },
      "description": "将 AGENTS.md 导入当前聊天输入框"
    }
  }
}
